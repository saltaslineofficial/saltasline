name = "saltasline-paytr"
main = "src/worker.js"
compatibility_date = "2026-09-01"

# Kopyalayıp wrangler.toml yapın; D1 create sonrasında verilen UUID'yi aşağıya yazın.
# Gizli anahtarları bu dosyaya veya GitHub'a KOYMAYIN.
[vars]
PAYTR_ACTIVE = "0"
PAYTR_TEST_MODE = "1"
TAX_VALIDATED = "0" # KDV ve nihai satış tutarı teyit edilmeden 1 yapılmamalıdır.
# Standart kargo bedeli sipariş başına 130,00 TL = 13000 kuruş.
# KDV henüz ayrıca hesaplanmıyor; vergi durumu teyit edilmeden sistemi açmayın.
SHIPPING_KURUS = "13000"

[[d1_databases]]
binding = "DB"
database_name = "saltasline-paytr-orders"
database_id = "D1_VERITABANI_UUID_BURAYA"
