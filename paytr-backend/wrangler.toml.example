name = "saltasline-paytr"
main = "src/worker.js"
compatibility_date = "2026-09-01"

# Kopyalayıp wrangler.toml yapın; D1 create sonrasında verilen UUID'yi aşağıya yazın.
# Gizli anahtarları bu dosyaya veya GitHub'a KOYMAYIN.
[vars]
PAYTR_ACTIVE = "0"
PAYTR_TEST_MODE = "1"
TAX_VALIDATED = "0" # KDV ve kargo fiyatın içindedir; muhasebe/fatura teyidi olmadan 1 yapılmaz.
# Kargo ücreti ürün fiyatlarının içindedir; sepet ve PayTR için ek ücret kesinlikle sıfırdır.
# Bu değeri sıfırdan farklı yapmak ödeme servisinin yapılandırma kontrolünü başarısız yapar.
SHIPPING_KURUS = "0"

[[d1_databases]]
binding = "DB"
database_name = "saltasline-paytr-orders"
database_id = "D1_VERITABANI_UUID_BURAYA"
